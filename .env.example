# Back office master password (/admin). Change it before going live.
ADMIN_PASSWORD=jsconf2026

# Secret used to sign the admin session cookie.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Production Postgres (Neon / Vercel).
# Without this variable the app falls back to local PGlite in .pglite/
# and needs no further setup.
DATABASE_URL=
