# Back office master password (/admin). Change it before going live.
ADMIN_PASSWORD=jsconf2026

# Secret used to sign the admin session cookie.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=


# Agenda oficial: API de jsconf-agenda (la misma que usa jsconf.mx).
# Se lee en el servidor y se cachea; el botón de /admin/sync la refresca al instante.
AGENDA_API_URL=https://jsconf-agenda.vercel.app/api/v1/ponentes.json
AGENDA_API_TOKEN=

# Subdominio que abre directo el botón de sincronizar: sync.tu-dominio.com
# (sigue pidiendo la contraseña del back office). Vacío = desactivado.
SYNC_SUBDOMAIN=
