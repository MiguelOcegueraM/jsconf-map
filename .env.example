# Contraseña maestra del back office (/admin). Cámbiala antes de publicar.
ADMIN_PASSWORD=jsconf2026

# Secreto para firmar la cookie de sesión del admin.
# Genera uno con: openssl rand -base64 32
AUTH_SECRET=

# Postgres de producción (Neon / Vercel Postgres).
# Sin esta variable la app usa PGlite local en .pglite/ y no necesitas nada más.
DATABASE_URL=
